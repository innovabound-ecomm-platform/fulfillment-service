{
  "name": "@innovabound-ecomm-platform/fulfillment-service",
  "version": "1.0.0",
  "description": "Fulfillment and shipping management service for the e-commerce platform",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "validate-db": "tsx scripts/validate-db.ts"
  },
  "keywords": [
    "fulfillment",
    "shipping",
    "warehouse",
    "tracking",
    "ecommerce"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@innovabound-ecomm-platform/fulfillment-db": "workspace:*",
    "@innovabound-ecomm-platform/kafka-client": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "jose": "^6.0.11",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@innovabound-ecomm-platform/eslint-config": "workspace:*",
    "@innovabound-ecomm-platform/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.7",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0-beta"
  }
}
